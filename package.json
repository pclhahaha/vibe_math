{
  "name": "vibe_math",
  "version": "1.0.0",
  "description": "Interactive math & physics — 90 lessons with p5.js + KaTeX",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "math",
    "physics",
    "education",
    "interactive",
    "visualization",
    "p5js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "gen:lessons": "python scripts/gen_lessons.py",
    "gen:crossrefs": "python scripts/gen_crossrefs.py",
    "gen:graph": "python scripts/build_graph.py",
    "gen:search": "python scripts/build_search.py",
    "gen:reading": "python scripts/add_reading.py",
    "gen:prereqs": "python scripts/add_prereqs.py",
    "gen": "python scripts/gen_lessons.py && python scripts/gen_crossrefs.py && python scripts/add_prereqs.py && python scripts/build_graph.py && python scripts/build_search.py",
    "check": "node scripts/check_katex.mjs && python scripts/check_all.py"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "katex": "^0.18.1",
    "p5": "^2.3.2"
  },
  "devDependencies": {
    "vite": "^8.2.0"
  }
}