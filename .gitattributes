# Normalize line endings and fix file types
* text=auto

# Source code — LF line endings
*.js text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.svg text eol=lf

# Text with CRLF (Windows) preserved
*.bat text eol=crlf
